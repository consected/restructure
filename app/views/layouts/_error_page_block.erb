<%
  unless defined? error_title
    error_title = nil
  end
  text = '&nbsp;'.html_safe unless defined?(text) && text.present?
%>
<div class="container well error-page-block">
  <h1><%= error_title || 'Unexpected Error' %></h1>
  <p class="">
    <%= text %>
  </p>
  <p class="text-center">
    <%=link_to 'Go Back', :back, class: 'btn btn-default' %>
  </p>
</div>
<% flash.discard %>
