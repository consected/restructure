<%
  # Navigation panel for the User Access Overview admin reports (GitHub Issues #1125, #1330).
  # Renders links to all UAO report perspectives, including the current one, preserving the 
  # current filter values so admins can switch perspective without re-entering them.

  all_reports = Report.active.where(
    item_type: UserAccessOverviewLinksHelper::USER_ACCESS_OVERVIEW_ITEM_TYPE
  ).order(:position, :id).to_a

  current_search_attrs = search_attrs_params_hash || {}
%>
<% if all_reports.any? %>
  <div class="uao-related-perspectives panel panel-default">
    <div class="panel-heading">
      <strong>User access overviews</strong>
    </div>
    <ul class="list-group">
      <% all_reports.each do |r|
           is_current = (@report&.id == r.id)
           forwarded = current_search_attrs.slice(:user, :app_type_id, :resource_type, :resource_name, :role_name)
           forwarded = forwarded.reject { |_, v| v.nil? || v.to_s.strip.empty? }
      %>
        <li class="list-group-item not-header<%= ' current-row' if is_current %>">
          <%= link_to r.name,
                      report_path(id: r.alt_resource_name, search_attrs: forwarded),
                      class: 'uao-related-perspective-link',
                      aria: (is_current ? { current: 'page' } : {}) %>
          <% if r.description.present? %>
            <span class="text-muted small uao-related-perspective-desc">&mdash; <%= r.description %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
