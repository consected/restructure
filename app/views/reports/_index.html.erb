<%
link_extras = {} unless defined? link_extras
simple_view = false unless defined? simple_view

link_extras ||= {}
extra_params = {} unless defined? extra_params
extra_params ||= {}
extra_params[:embed] = true if link_extras[:data] && link_extras[:data][:remote]
%>
<table class="table tablesorter admin-list">
  <thead>
    <tr>
      <th></th>
      <th>Name</th>
      <th>Description</th>
      <% unless simple_view %>
      <th></th>
      <th></th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% @reports.each do |list_item| 
    
          content = markdown_to_html list_item.list_description
          if content.present?
            begin
              content = Formatter::Substitution.substitute( content, data: list_item, ignore_missing: true).html_safe
            rescue StandardError => e
              content = "<p class='text-danger'>Error processing report description: #{e.message}</p>".html_safe
            end
          end    
    %>
    <tr class="<%=list_item.disabled ? 'disabled-result' : ''%> report-type-<%= list_item.report_type %> <%= list_item.get_query_count? ? 'report-auto' : '' %>" data-report-id="<%=list_item.id %>">
      <td class="report-index__type-cell"><span class="hidden"><%= list_item.report_type %></span><span class="glyphicon <%= list_item.report_type == 'count' ? 'glyphicon-record' : list_item.report_type == 'regular_report' ? 'glyphicon-list-alt' : 'glyphicon-search'  %>" title="<%= list_item.report_type.humanize %>"></span></td>

      <td class="report-index__name-cell"><%= link_to  list_item.name, report_path(list_item.alt_resource_name, extra_params), link_extras %></td>

      <td class="report-index__description-cell"><%= markdown_to_html content %></td>
      <% unless simple_view %>
      <td class="report-index__search-attr-cell report-search-attr"></td>
      <td class="report-index__measure-cell report-measure"></td>
      <% end %>

    </tr>
    <% end %>
  </tbody>
</table>