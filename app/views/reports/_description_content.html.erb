<%
  content = markdown_to_html @report.description
  if content.present?
    d = @report.attributes.merge(@runner.data_reference.substitution_data)
    content = Formatter::Substitution.substitute(content, data: d, ignore_missing: :show_tag).html_safe
  end
%>
<div class="report-form-content">
  <%= content %>
</div>      
