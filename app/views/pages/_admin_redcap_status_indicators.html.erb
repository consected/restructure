<span>
<% 
  if current_admin.can_admin?(:redcap) && current_admin&.matching_user&.accessible_app_types&.map(&:name)&.include?('ref-data')
    failed_projects = Redcap::ProjectAdmin.failed_scheduled_projects.order(:name)
    if failed_projects.any?
      content = failed_projects.map { |p| "#{p.name} (#{p.study}) - #{current_user_date_time(p.failed_at)}" }
      content_html = "<strong>Failed scheduled pulls:</strong><ul><li>#{ content.join('<li>') }</ul>".html_safe
%>
<i class="glyphicon glyphicon-alert error-mark"
    data-toggle="popover"
    data-trigger="click hover"
    data-content="<%=content_html%>"
    data-html="true"
    title="REDCap Project Failures"></i>
<% 
    end
  end
%>
</span>
