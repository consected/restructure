<span>
<% 

  unless @server_info.configuration_successful
    content = @server_info.configuration_failed_reason
    # h leaves html_safe reasons (linked dynamic definition load issues) unchanged and escapes the rest
    content_html = "<ul><li>#{ content.map { |reason| h(reason) }.join('<li>') }</ul>"
%>
<i class="glyphicon glyphicon-alert error-mark"
    data-toggle="popover"
    data-trigger="click hover"
    data-content="<%=content_html%>"
    data-html="true"></i>
<% end %>
</span>