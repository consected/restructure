<%= handlebars_template_tag('external-links-template') do %>
  <div class="row">
    <div class="col-sm-24">
      <% Admin::ExternalLink.selector_name_value_pair_no_downcase.each do |s|%>
        <%= link_to "#{s.first}", s.last, target: s.first.ns_underscore, class: "open-in-new-window", title: "opens in a new window" %>
      <% end %>
    </div>
  </div>
<% end %>
