<h4>Files</h4>
<div id="admin-filestore-block-<%= object_instance.id %>">
</div>
<% if current_user.app_type&.name != 'ref-data' %>
<p>The user must 
  <%= link_to "switch to the <b>Ref Data</b>".html_safe, 
              redcap_project_admins_path(
                no_redirect: true, 
                # use_app_type: Admin::AppType.active.find_by_name('ref-data')&.id
              ) %>
  project to view the stored REDCap files</p>
<% elsif object_instance&.file_store&.id %>
<script> 
window.setTimeout(function() {
  var data = {
    to_record_id: <%= object_instance.file_store.id %>,
    to_record_data: 'admin',
    to_record_label: 'Admin Files',
    from_record_id: <%= object_instance.id %>,
    from_record_type_us: '<%= object_instance.admin_resource_name.singularize %>',
    prevent_edit: true,
    can_download: true
  };
  var block = $('#admin-filestore-block-<%= object_instance.id %>');
  _fpa.view_template(block, 'filestore-view-template', data); 

}, 500);
</script>
<% else %>
<p>File store not configured</p>
<% end %>