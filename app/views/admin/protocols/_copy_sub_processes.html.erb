<div class="col-sm-24 admin-head-block">
  <h4>Copy Sub Processes to Another Protocol</h4>

  <div id="copy-sub-processes-block" class="">
  <%= form_tag admin_protocols_copy_sub_processes_path, action: :post do %>
    <div class="form-group">
      <div><%= label_tag :from_protocol_id %></div>
      <%= select_tag :from_protocol_id, active_protocol_options, include_blank: true, class: 'use-chosen' %>
    </div>
    <div class="form-group">
      <div><%= label_tag :to_protocol_id %></div>
      <%= select_tag :to_protocol_id, active_protocol_options(default_protocol_id: @protocol&.id), include_blank: true, class: 'use-chosen' %>
    </div>
    <div class="form-group">
      <%= hidden_filter_fields %>
      <%= submit_tag :copy, class: "btn btn-primary" %>
    </div>
  <% end %>
  </div>
</div>
