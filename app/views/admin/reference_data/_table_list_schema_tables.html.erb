<%
  @table_info_for_schema.each do |table|       

    table_name = table['table_name']
    history_table = table_name.end_with? '_history'
    table_comment = Admin::MigrationGenerator.table_comment(table_name, @schema_name)
    object_type = Admin::TableViewInfo.object_type_in_schema(table_name, @schema_name)
    definition = @dynamic_definitions[table_name]
%>
<li id="t-<%=@schema_name%>-<%=table_name%>" data-schema="<%=@schema_name%>" data-object-type="<%=object_type%>" class="ref-table-item <%=history_table ? 'history-table' : 'regular-table' %>">
  <a href="#tblock-<%=@schema_name%>-<%=table_name%>" data-toggle="collapse" class="table-name-collapser collapsed"><%= table_name  %></a>
  <%= render partial: 'admin/reference_data/object_type_badge', locals: { object_type: } %>
  <span class="ref-table-item__actions">
  <% if @can_view_table_data %>
    <%= link_to '', report_path('reference_data__table_data',
                                table_name: table_name,
                                schema_name: @schema_name,
                                search_attrs: { no_run: true }),
                target: '_blank', class: 'glyphicon glyphicon-search ref-table-item__icon-link',
                title: "Search #{Admin::TableViewInfo.object_type_label(object_type)} data",
                aria: { label: "Search #{Admin::TableViewInfo.object_type_label(object_type)} data" } %>
  <% end %>
  <% if definition %>
    <% definition_label = "Edit #{definition.class.human_name.downcase} definition" %>
    <%= link_to '', send("#{definition.class.base_route_name.pluralize}_path", filter: { id: definition.id }, perform_action: 'edit'),
                target: '_blank', class: 'glyphicon glyphicon-cog ref-table-item__icon-link ref-table-definition-link',
                title: definition_label, aria: { label: definition_label } %>
  <% end %>
  </span>
  <% if table_comment %>
    <div class="table-comment help-block"><%= table_comment %></div>
  <% end %>
</li>
<ul id="tblock-<%=@schema_name%>-<%=table_name%>" class="ref-tblock collapse" data-schema-name="<%=@schema_name%>" data-table-name="<%=table_name%>">
  ...
</ul>
<% end %>
