<div>
  <div class="table-list-block ref-tables admin-form__left-aligned" data-result="table-list-block">
    <div class="row">
      <div class="form-group col-md-6">
        <%= select_tag 'primary_tables_schema_select', options_for_select(@schemas), prompt: '-- select schema --', class: 'form-control input-sm ff use-chosen'  %>
      </div>
      <div class="form-group col-md-6">
        <%= tag.input type: 'search', id: 'primary_tables_search', autocomplete: 'off',
                      class: 'form-control input-sm typeahead',
                      placeholder: 'search table or view name',
                      aria: { label: 'Search tables and views by name' },
                      data: { search_items: @table_search_items.to_json } %>
      </div>
      <div class="form-group col-md-8">
        <label class="">
          <input type="checkbox" id="primary_tables_filter_out_history" checked class="admin-ref-data__checkbox--inline" /> filter out history tables
        </label>
      </div>
    </div>
    <p class="ref-tables__no-match help-block" role="status" hidden>No tables or views match the search.</p>
    <% 
      @schemas.each do |schema_name| 
    %>
    <ul id="table-list-<%= schema_name %>" class="table-list collapse" data-schema-name="<%= schema_name %>">
      ...
    </ul>
  <% end %>
</div>
</div>
