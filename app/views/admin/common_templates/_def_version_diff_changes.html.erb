<% 
if changes.present? 
  # Show the diffs in the body
%>
<tbody>
<% 
  changes.each do |field_name, values|
    previous_val = values[0]
    current_val = values[1]
    
    # Skip if values are identical after cleaning
    next if previous_val == current_val
    
    # Only add line numbers for multiline fields
    multiline_fields = ['options', 'extra_log_types']
    show_line_numbers = multiline_fields.include?(field_name.to_s)
    
    diff_html = version_diff_field_html(previous_val, current_val, show_line_numbers: show_line_numbers)
    left_html = diff_html[:left]
    right_html = diff_html[:right]
%>
  <tr>
    <td><strong><%= field_name.to_s.humanize %></strong></td>
    <td><%= left_html.html_safe %></td>
    <td><%= right_html.html_safe %></td>
  </tr>
<% 
  end 
%>
</tbody>
<% 
end # if changes.present?
%>
