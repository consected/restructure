<div class="data-results" data-subscription="admin-list" >
  <div data-result="admin-list">
    <% if @total_version_count %>
      <p class="admin-version__count text-muted">
        <%= pluralize(@total_version_count, 'version') %>
        <% if @version_limit && @total_version_count > @version_limit %>
          (most recent <%= @version_limit %> versions shown)
        <% end %>
      </p>
    <% end %>
    <% if @version_diffs.blank? %>
      <p class="text-muted">No version changes to display.</p>
    <% else %>
      <% @version_diffs.each_with_index do |diff_data, idx| %>
        <div class="version-diff-section admin-version__section">
          <h4>
            Version Change <%= idx + 1 %>
            <small class="text-muted">
              <%= format_version_timestamp(diff_data[:previous]['updated_at'] || diff_data[:previous]['created_at']) %>
              →
              <%= format_version_timestamp(diff_data[:current]['updated_at'] || diff_data[:current]['created_at']) %>
            </small>
          </h4>
          
          <table class="app-import-upload-results table table-bordered">
            <%= render partial: 'admin/common_templates/def_version_head_identifiers', 
                       locals: { current_version: diff_data[:current], previous_version: diff_data[:previous] } %>
            <%= render partial: 'admin/common_templates/def_version_diff_changes', 
                       locals: { changes: diff_data[:changes] } %>
          </table>
        </div>
      <% end %>
    <% end %>

    <% if @next_versions_page_path %>
      <p class="admin-version__load-more">
        <%= link_to "Load #{[Dynamic::VersionHandler::MAX_DISPLAYED_VERSIONS, @total_version_count - @version_limit].min} more versions",
                    @next_versions_page_path,
                    'data-remote': true,
                    'data-target-force': true,
                    'data-target': "##{@versions_container_id}" %>
      </p>
    <% end %>

  </div>
</div>
