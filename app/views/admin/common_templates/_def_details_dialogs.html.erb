<% if object_instance.persisted? && object_instance.options_text && !object_instance.disabled
     dialogs = object_instance.option_configs.map { |d| d.dialog_before.map { |e| e.last } }.flatten %>
<div class="activity-list-dialogs">
  <label>dialogs</label>
  <% if dialogs.present? %>
  <ul class="al-reference-list">  
  <% dialogs.each do |l| 
       mt = Admin::MessageTemplate.active.find_by(name: l[:name])
       unless mt 
  %>
    <li>Add a <%= link_to link_label_open_in_new("new dialog for '#{l[:name]}'"), admin_message_templates_path(init_with: {message_type: 'dialog', template_type: 'content', category: object_instance.category, name: l[:name] }, perform_action: 'new'), target: "_blank" %>
    with <i>message type:</i> <b>dialog</b>, <i>template type:</i> <b>content</b> &amp;  <i>name:</i> <b><%= l[:name] %></b>
    </li>
  <%
          next
        end
  %>
  <li>
    <%= link_to link_label_open_in_new("#{mt.category} - #{mt.name}"), admin_message_templates_path(filter: {id: mt.id}, perform_action: 'edit'), target: "_blank" %>
  </li>
  <% end %>
  </ul>
  <% end %>
  <hr />
    <p>Add a <%= link_to link_label_open_in_new("new dialog template"), admin_message_templates_path(init_with: {message_type: 'dialog', template_type: 'content', category: object_instance.category}, perform_action: 'new'), target: "_blank" %>
    with <i>message type:</i> <b>dialog</b> &amp; <i>template type:</i> <b>content</b></p>
</div>
<% end %>
