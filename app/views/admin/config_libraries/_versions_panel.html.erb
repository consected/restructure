<div id="def-versions-embedded" class="def-versions-embedded--config-library">
  <h4>Definition Versions</h4>
  <% if object_instance.persisted? 
       @all_versions = object_instance.all_versions
  
  
  %>

  <div class="admin-result-index" id="embedded-config-library-def-versions-embedded">
    <%= link_to "Load", versions_admin_config_library_path(                          
                          view_as: 'simple-embedded', readonly: true, id: object_instance.id), 
                          'data-remote': true,
                          'data-target-force': true,
                          'data-target': '#embedded-config-library-def-versions-embedded'
                          %>
  </div>

  <% end %>
</div>
