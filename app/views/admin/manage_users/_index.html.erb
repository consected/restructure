<div class="data-results" data-subscription="admin-list" >
  <div data-result="admin-list">
    <%= show_admin_heading %>
    <p>
      <%= show_filters %>
    </p>
    <%= render partial: 'head_info' if show_head_info %>
    <div id="admin-edit-" data-preprocessor="admin-edit-form" data-subscription="admin-edit-form-" class="new-block new-below">
      <% if @updated_with %>
        <%= render partial: 'show'%>
      <% end %>
    </div>
    <table class="table tablesorter admin-list">
      <thead>
        <tr>
          <th class="no-sort"></th>
          <th class="no-sort"></th>
          <th class="no-sort"></th>
          <th class="no-sort"></th>
          <th>ID</th>
          <th>User</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Apps</th>
          <th>Current App</th>
          <th>Password expires in (days)</th>
          <th>Account Expiration</th>
          <th>Signed in at</th>
          <% if @users.first.respond_to? :confirmed_at %><th>Confirmed</th><% end %>
          <th>Locked</th>
          <th>Do Not Email</th>
          <th>API Only</th>
          <th>2FA set up?</th>
          <th>Disabled</th>
          <th>Admin</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |list_item| %>
          <tr class="<%=list_item.disabled ? 'disabled-result' : ''%>">
            <td><%= admin_edit_btn list_item.id%> &nbsp; <%= admin_edit_btn list_item.id, copy: list_item%> </td>
            <td><%= link_to "contact", users_contact_infos_path(filter: {user_id: list_item.id})  %></td>
            <td><%= link_to "roles", admin_user_roles_path(filter: {user_id: list_item.id}) %></td>
            <td><%= user_access_overview_link 'access overview', :by_role, search_attrs: { user: list_item.id }, required: %i[user] %></td>
            <td><%= list_item.id %></td>
            <td><%= list_item.email %></td>
            <td><%= list_item.first_name %></td>
            <td><%= list_item.last_name %></td>
            <td class="user-app-list"><% list_item.accessible_app_types.each do |a| %>
                <p><span><%= a&.label %></span></p>
              <% end %>
            </td>
            <td><%= index_list_item_boolean_field(list_item.accessible_app_type_ids.include?(admin_app_type&.id)) %></td>
            <td><%= list_item.expires_in == 0 ? '<i class="password-expired">expired</i>'.html_safe : list_item.expires_in %></td>
            <td><%= list_item.expire_datetime&.strftime('%Y-%m-%d %H:%M') %></td>
            <td><%= list_item.current_sign_in_at %></td>
            <% if list_item.respond_to? :confirmed_at %><td><%= index_list_item_boolean_field(list_item.confirmed_at) %></td><% end %>
            <td><%= index_list_item_boolean_field(list_item.access_locked?) %></td>
            <td><%= index_list_item_boolean_field(list_item.do_not_email) %></td>
            <td><%= index_list_item_boolean_field(list_item.api_access_only) %></td>
            <td><%= index_list_item_boolean_field(list_item.otp_secret.present?) %></td>
            <td><%= index_list_item_boolean_field(list_item.disabled) %></td>
            <td class="admin-item-admin-infos">
              <%= admin_last_updated_by_icon(list_item) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%=  render partial: 'admin_handler/index_actions'  %>
  </div>
</div>
