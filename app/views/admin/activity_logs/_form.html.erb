<div class="data-results">
  <div data-result="admin-edit-form-"  class="admin-edit-form admin-activity-log">
    <div class="row">
      <div class="col-sm-12">
        <%= form_for([:admin, object_instance], class: "form-formatted admin-edit-form", remote: true) do |f| %>
          <%= render partial: 'admin_handler/form_errors' %>
          <%= render partial: 'admin/activity_logs/form/fields', locals: {f:} %>
          <%= render  partial: 'admin/activity_logs/form/traditional_al_fields', locals: {f:} %>
          <div class="admin-inline-update-report">
            <%= f.submit class: 'btn btn-primary pull-right' %>      
          </div>
          <%= render partial: 'admin/activity_logs/form/options_block', locals: {f:} %>
            <div class="admin-buttons-block">
                <%= hidden_filter_fields %>
                <p><%= admin_submit_and_cancel(f) %></p>
              
            </div>
        <% end %>
      </div>
      <div class="col-sm-12">
        <%= render partial: 'admin/activity_logs/form/info_block' %>
      </div>
    </div>
  </div>
</div>
