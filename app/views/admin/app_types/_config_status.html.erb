
<% 
  current_search_paths = Admin::MigrationGenerator.current_search_paths || [] 
  active_ids = Admin::AppType.active_app_types.pluck(:id)
  user_has_access = Admin::AppType.all_available_to(current_user)&.find { |app| app.id == @app_type.id } if current_user
%>
<div class="config-status-block">
<p>
  <% if @config_notices.present? %>
  <span class="glyphicon glyphicon-exclamation-sign error-mark" title="configuration errors"></span>
  <% else %>
  <span class="glyphicon glyphicon-check val-checked"></span>
  <% end %>
  Configurations
</p>
<p>
  <% if current_search_paths.include?(@app_type.default_schema_name) %>
  <span class="glyphicon glyphicon-check val-checked"></span>
  <% else %>
    <span class="glyphicon glyphicon-exclamation-sign error-mark" title="schema not in search path"></span>
  <% end %>
  Schema in search path?
</p>
<p>
    <%= if !@app_type.disabled
      "<span class=\"glyphicon glyphicon-check val-checked\"></span>".html_safe  
    else
      '<span class="glyphicon glyphicon-exclamation-sign" title="app type has been marked as disabled"></span>'.html_safe
    end
    %>   
    Enabled?
</p>
<p>
    <%= if @app_type.active_on_server?
      "<span class=\"glyphicon glyphicon-check val-checked\"></span>".html_safe  
    elsif active_ids&.include?(@app_type.id) || !active_ids || active_ids.empty?
      '<span class="glyphicon glyphicon-exclamation-sign error-mark-in-circle" title="app active but schema not in search path"></span>'.html_safe
    else
      "<span class=\"val-unchecked\"></span>".html_safe  
    end
    %>
    Active on server?
</p>
<p>
    <%= if user_has_access
      "<span class=\"glyphicon glyphicon-check val-checked\"></span>".html_safe  
    else
      '<span class="val-unchecked" title="user has not been granted user access control for this app_type"></span>'.html_safe  
    end
    %>
    Admin user has access? 
</p>
<p>
    <%= if NfsStore::Manage::Filesystem.app_type_containers_path_exists?(@app_type.id)
      "<span class=\"glyphicon glyphicon-check val-checked\"></span>".html_safe  
    else
      '<span class="val-unchecked" title="configure the filestore app filesystem"></span>'.html_safe  
    end
    %>
    Filestore filesystem ready? 
</p>

<%
  missing_filestore = !NfsStore::Manage::Filesystem.app_type_containers_path_exists?(@app_type.id)
  missing_load_app_type = Settings::OnlyLoadAppTypes && !Settings::OnlyLoadAppTypes.include?(@app_type.id)
  missing_schema = !current_search_paths.include?(@app_type.default_schema_name)
  has_missing_configs = missing_filestore || missing_load_app_type || missing_schema
%>
<% if has_missing_configs %>
<div class="panel panel-warning status-extra-info">
  <div class="panel-heading" role="tab" id="missing-configs-heading-<%= @app_type.id %>">
    <h4 class="panel-title">
      <a class="collapsed" role="button" data-toggle="collapse"
         href="#missing-configs-collapse-<%= @app_type.id %>" aria-expanded="false"
         aria-controls="missing-configs-collapse-<%= @app_type.id %>">
        <span class="glyphicon glyphicon-exclamation-sign"></span>
        Missing Configurations
      </a>
    </h4>
  </div>
  <div id="missing-configs-collapse-<%= @app_type.id %>" class="panel-collapse collapse"
       role="tabpanel" aria-labelledby="missing-configs-heading-<%= @app_type.id %>">
    <div class="panel-body">
      <% if missing_filestore %>
        <p>Configure the filestore app filesystem</p>
        <pre><code><%= Rails.env.production? ? 'RAILS_ENV=production ' : 'SUBDIR=test-fphsfs' %> app-scripts/setup_filestore_app.sh <%= @app_type.id %></code></pre>
      <% end %>
      <% if missing_load_app_type %>
        <p>Update the <code>FPHS_LOAD_APP_TYPES</code> environment variable</p>
        <pre><code>FPHS_LOAD_APP_TYPES=<%= Settings::OnlyLoadAppTypes.join(',') %>,<%= @app_type.id %></code></pre>
      <% end %>
      <% if missing_schema %>
        <p>Add default schema to database search path environment variable <code>FPHS_POSTGRESQL_SCHEMA</code></p>
        <pre><code>FPHS_POSTGRESQL_SCHEMA=<%= ENV['FPHS_POSTGRESQL_SCHEMA'] %>,<%= @app_type.default_schema_name %></code></pre>
      <% end %>
    </div>
  </div>
</div>
<% end %>

</div>
