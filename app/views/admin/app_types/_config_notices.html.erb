
<% if @config_notices.present? %>
<p><a href="#admin-panel-components">jump to components</a></p>
<div class="config-error-block">
  <div class="panel-group" id="accordion-notices" role="tablist" aria-multiselectable="true">
  <% 
  prev_id = nil
  sorted_cns = @config_notices.sort_by { |ce| "#{ce[:resource_name]}--#{ce[:name]}--#{ce[:type]}" }
  sorted_cns.each do |ce| 
    el_id = "app-type-config-notices-body--#{ce[:resource_name]}--#{ce[:name].id_hyphenate}-#{ce[:type].id_hyphenate}"
    next if el_id == prev_id

    prev_id = el_id
    head_el_id = "app-type-config-notices-heading--#{ce[:name].id_hyphenate}-#{ce[:type].id_hyphenate}"
    title = "<span class=\"activity-list-name\">#{ce[:resource_name]} - #{ce[:name]}</span> - #{ce[:type]}".html_safe
  %>
    <div class="panel panel-default">
      <div class="panel-heading" role="tab" id="<%=head_el_id%>">
        <h4 class="panel-title">
           <%= link_to title, "\##{el_id}", 
              role: "button", 
              data: { toggle: "collapse", parent: "#accordion-notices" }, 
              'aria-expanded' =>"true",
              'aria-controls'=>"\##{el_id}",
              class: 'app-type-config-notices-head-link' %> 
          </h4>
      </div>
      <div id="<%=el_id%>" class="panel-collapse collapse" role="tabpanel" aria-labelledby="<%=head_el_id%>">   
        <div class="panel-body">
          <% sorted_cns
              .filter { |cn| "#{cn[:resource_name]}--#{cn[:name]}--#{cn[:type]}" == "#{ce[:resource_name]}--#{ce[:name]}--#{ce[:type]}"}
              .each do |cn| %>
              <% if cn[:config_resource_name] %>
          <p><%= link_to link_label_open_in_new('edit resource'), send("#{cn[:config_object].class.base_route_name.pluralize}_path", filter: {id: cn[:config_object].id}, perform_action: 'edit'), target: '_blank' %><p>
              <% end %>
          <div class="config-notice">
            <p><%= cn[:message] %></p>
            <pre><%= cn[:config_def].to_yaml.sub("---\n",'') %></pre>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  </div>
</div>
<% end %>