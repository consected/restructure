<div class="data-results" data-subscription="admin-list" >
  <div data-result="admin-list">
    <%= show_admin_heading %>
    <p>
      <%= show_filters %>
    </p>
    <div id="admin-edit-" data-preprocessor="admin-edit-form" data-subscription="admin-edit-form-" class="new-block new-below">
      <% if @updated_with %>
        <%= render partial: 'form'%>
      <% end %>
    </div>

<table class="table tablesorter admin-list">
  <thead>
    <tr>
      <th class="no-sort"></th>
      <th>Name</th>
      <th>Item Type Name</th>
      <th>Category</th>

      <th>Report Type</th>
      <th>Auto</th>
      <th>Searchable</th>
      <th>Admin</th>
      <th class="no-sort"></th>
    </tr>
  </thead>

  <tbody>
    <%= render partial: view_path('item'), collection: @reports, as: :list_item %>
  </tbody>
</table>

<%=  render partial: 'admin_handler/index_actions'  %>
  </div>
</div>
