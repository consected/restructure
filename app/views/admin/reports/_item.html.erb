<% if @updated_with %>
<div class="data-results">
  <%= render partial: 'form'%>
  <table data-result="admin-list-item" data-replace-element-id="#admin-item-<%=list_item.id%>">
<% end %>
    <tr class="admin-list-item <%=list_item.disabled ? 'disabled-result' : ''%> <%= list_item.persisted? ? '' : 'new-record hidden'%> <%= action_name.in?(['create', 'update']) ? 'saved-row' : ''%> " id="admin-item-<%=list_item.id%>" data-result-position="<%= list_item.persisted? ? 'replace' : 'after'%>" data-preprocessor="">
      <td class="edit-btn-cell"><%= admin_edit_btn list_item.id %>
      &nbsp;
      <%= admin_edit_btn list_item.id, copy: list_item %> </td>

      <td><%= link_to  list_item.name, report_path(list_item.alt_resource_name), target: 'report', title: 'opens in a new window' %></td>
      <td><%= list_item.alt_resource_name %></td>
      <td><%= list_item.item_type %></td>

      <td><%= list_item.report_type %></td>
      <td>
        <%= if list_item.auto
          "<span class=\"glyphicon glyphicon-check val-checked\"><span class=\"hidden\">1</span></span>".html_safe
        else
          "<span class=\"val-unchecked\"><span class=\"hidden\">0</span></span>".html_safe
        end
        %>
      </td>
      <td>
        <%= if list_item.searchable
          "<span class=\"glyphicon glyphicon-check val-checked\"><span class=\"hidden\">1</span></span>".html_safe
        else
          "<span class=\"val-unchecked\"><span class=\"hidden\">0</span></span>".html_safe
        end
        %>
      </td>

      <td class="admin-item-admin-infos">
        <%= admin_last_updated_by_icon(list_item) %>
      </td>
    </tr>
<% if @updated_with %>
  </table>
</div>
<% end %>