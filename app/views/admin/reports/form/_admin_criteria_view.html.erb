<% if object_instance.persisted? 
    @runner = object_instance.runner
    @report = object_instance
    @view_options = @report.report_options(fail_without_exception: true)&.view_options
%>  
  <div class="admin-view report-criteria">
  <%= form_tag report_path(@report.id), 
        method: :get, 
        class: 'form-formatted search_report', 
        id: "report_query_form", 
        data: { result_target: "#embed_results_block", preprocessor: 'reports_result' }, 
        remote: true do 
  %>

    <h3><%=@report.name%></h3>
    <%= render partial: 'reports/description_content' %>

    <div class="row report-criteria-fields">
    <% begin %>
      <%= render partial: 'reports/criteria/fields' %>
      <%#= render partial: 'reports/criteria/inline_search_button_block' %>
<% 
  rescue => e
%>
<h3>Failure in criteria view</h3>
<code><%= e %></code>
<% if current_admin %>
<pre>
<%= e.short_string_backtrace %>
</pre>
<% end 
end%>      
    </div>
    <div class="row form-actions" style="border-color: transparent;">
      <%= hidden_field_tag  "search_attrs[#{Reports::Runner::ReportIdAttribName}]", ''%>
      <%= hidden_field_tag  "part", 'results', id: nil%>
      <%= hidden_field_tag  "embed", true, id: nil%>
      <%= hidden_field_tag  "force_view_as", 'table', id: nil%>
      
      <%= button_tag :run,
          name: 'commit', 
          value: 'table', 
          type: 'submit', 
          class: "btn btn-default keep-notices", 
          id: "report-form-submit-btn"
    %>
    </div>

    <%= render partial: 'reports/criteria_view_css' %>
    <% if @report.searchable %><%= render partial: 'reports/master_results_css' %><% end %>
<% end %>
  </div>
<% 
  end 
%>  