<%
  unless defined? force
    force = false
  end

  begin

    mapped_vars = OptionConfigs::TemplateOptionMapping.dynamic_model_all_configs_mapping(def_record, current_user)
    mapped_vars[:force] = force

    if def_record.implementation_class_defined?(::DynamicModel, fail_without_exception: true)
%>
<%= render partial: 'dynamic_models/common_search_results_template', 
           locals: mapped_vars  if force || current_user.has_access_to?(:access, :table, def_record.resource_name) %>
<% 
    end
  rescue StandardError=> e
      logger.error "Error loading search results template item for dynamic model #{def_record&.id}: #{e}\n#{e.short_string_backtrace}" 
%>
<%= "Error loading search results template item for dynamic model #{def_record&.id}: #{e}" %>
<% end %>