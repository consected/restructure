<%

  options = field_options_for(form_object_instance, field_name_sym)
  options.merge! data: {attr_name: field_name_sym, object_name: form_object_item_type_us}
  fn = form_object_instance.attributes[field_name_sym.to_s]
  tn = form_object_instance.class.table_name
  sn = form_object_instance.class.definition.schema_name
  record_id = form_object_instance.record_id
  sntn = "#{sn}.#{tn}"
  tns = [tn , sntn]
  project_admin = Redcap::ProjectAdmin.active.find_by(dynamic_model_table: tns)
  if project_admin
    project_admin.current_user = current_user 
    container = project_admin.file_store
    path = "#{project_admin.dynamic_model_table}/file-fields/#{record_id}" if record_id
    sf = container&.stored_files.find_by(path:, file_name: field_name_sym.to_s) if path
  end
  if sf
    url = "/nfs_store/downloads/#{container.id}?activity_log_id=#{container.parent_item&.id}&activity_log_type=redcap__project_admin&download_id=#{sf.id}&retrieval_type=stored_file"
  end
%>
<%= form.label field_name_sym, label_for(field_name_sym, labels, /^fixed_/) %>
<span class="redcap-file-field">
  <% if url %><%= link_to fn, url, class: 'redcap-file-use-secure-view' %><% else %><%=fn%><% end %>  
</span>
