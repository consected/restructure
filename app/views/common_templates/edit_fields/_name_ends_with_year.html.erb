<%= form.label field_name_sym, label_for(field_name_sym, labels) %>
<%
  h = {}
  begin
    r = Settings.const_get("#{field_name.camelize}Range")
    h[:in] = r if r
  rescue StandardError => e
    h[:in] = nil
  end

%>
<% 
  default_options= {
    step: 1,
    pattern: '\\d{4,4}',
    minlength: 4,
    maxlength: 4,
    data: {
      attr_name: field_name_sym, 
      object_name: form_object_item_type_us
    },
    class: 'no-mask year-field'
  }

  new_options = h.merge(default_options)
  new_options = new_options.merge(field_options_for(form_object_instance, field_name_sym))  
%>

<%= form.number_field field_name_sym, new_options %>
