<%= handlebars_template_tag('search-count-template') do %>
  <span>
  {{#with count}}
  <span class="search_count">{{count}}</span> record{{#is count '!==' 1}}s{{/is}}
  {{#is count '>' show_count }} - showing {{show_count}} results - refine search to show others{{/is}}
  </span>
  {{/with}}
<% end %>
